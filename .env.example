# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.wy1z6.mongodb.net/?retryWrites=true&w=majority&appName=ai-day-demo
MONGODB_DB=rag_demo
MONGODB_COLLECTION=knowledge_base

# --- Voyage AI (used for RERANK only; embeddings are generated inside Atlas via autoEmbed) ---
# Atlas-created "Model API keys" route to https://ai.mongodb.com/v1
# (use https://eu.ai.mongodb.com/v1 or https://us.ai.mongodb.com/v1 if the key is scoped).
# Keys created on the Voyage platform route to https://api.voyageai.com/v1.
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_API_KEY=
VOYAGE_RERANK_MODEL=rerank-3

# --- LLM: DeepSeek (OpenAI-compatible) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# --- Server ---
PORT=3000
